{
  "functions": {
    "api/*.py": {
      "includeFiles": "api/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/health.py"
    },
    {
      "source": "/analyze",
      "destination": "/api/analyze.py"
    },
    {
      "source": "/api/py/:path*",
      "destination": "/api/:path*.py"
    }
  ]
}
